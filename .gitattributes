# --- Universal baseline ---
# Line endings: LF in repo; checkout-native on Windows. PowerShell stays CRLF
# because some pwsh hosts trip on LF-only .ps1/.cmd.
* text=auto eol=lf
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.cmd   text eol=crlf
*.bat   text eol=crlf

# Mark common binaries so git stops trying to diff them
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.tgz   binary
*.bz2   binary
*.xz    binary
*.7z    binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary

# --- Merge strategy: append-only "durable trail" files ---
# Nearly every PR appends to these (a CHANGELOG entry, a parking-lot row), so two
# parallel PRs ALWAYS collide on them. `merge=union` makes git concatenate both
# sides instead of raising a conflict — the correct behavior for append-only
# logs. (`union` is a built-in git merge driver — no extra config.) Skim the
# result at release time for the rare duplicate/out-of-order line.
CHANGELOG.md        merge=union
docs/parking-lot.md merge=union
